{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=easylang.db"
  },
  "Dictionary": {
    "BaseUrl": "https://api.dictionaryapi.dev/api/v2/entries/en/",
    "TimeoutSeconds": 10
  },
  "Llm": {
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "gpt-4o-mini",
    "ApiKey": "",
    "ExplanationLanguage": "Russian",
    "TimeoutSeconds": 60,
    "UseJsonMode": true
  },
  "Ocr": {
    "TesseractPath": "tesseract",
    "Language": "eng",
    "PageSegmentationMode": null,
    "TimeoutSeconds": 30
  },
  "Review": {
    "Scheduler": "Fixed",
    "KnownAfterDays": 21,
    "Adaptive": {
      "TargetRetention": 0.85,
      "BaseLog2HalfLife": 2.0,
      "CorrectWeight": 2.0,
      "WrongWeight": -1.0,
      "DifficultyPriorSigma": 1.0
    }
  },
  "Jwt": {
    "Issuer": "EasyLangApi",
    "Audience": "EasyLangApi",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Quotas": {
    "ExpensiveRequestsPerMinute": 30,
    "LookupsPerDay": 500
  }
}
