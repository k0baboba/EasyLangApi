{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=easylang.db"
  },
  "Dictionary": {
    "BaseUrl": "https://api.dictionaryapi.dev/api/v2/entries/en/",
    "TimeoutSeconds": 10
  },
  "Llm": {
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "gpt-4o-mini",
    "ApiKey": "",
    "ExplanationLanguage": "Russian",
    "TimeoutSeconds": 60,
    "UseJsonMode": true
  },
  "Ocr": {
    "TesseractPath": "tesseract",
    "Language": "eng",
    "PageSegmentationMode": null,
    "TimeoutSeconds": 30,
    "ThreadLimit": 1
  },
  "Review": {
    "Scheduler": "Fixed",
    "QueueOrder": null,
    "KnownAfterDays": 21,
    "Adaptive": {
      "TargetRetention": 0.8,
      "LearningRate": 0.05,
      "L2": 0.0001,
      "InitialWeights": null,
      "RoundToWholeDays": true,
      "MinIntervalDays": 1,
      "MaxIntervalDays": 365
    }
  },
  "Jwt": {
    "Issuer": "EasyLangApi",
    "Audience": "EasyLangApi",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Quotas": {
    "ExpensiveRequestsPerMinute": 30,
    "LookupsPerDay": 500
  }
}
