<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Мост для симуляции из srs/: Python-ученик спрашивает решения у настоящего
    AdaptiveScheduler основного приложения. Зависимость односторонняя: мост ссылается
    на приложение, приложение о мосте не знает (EasyLangApi.csproj исключает srs/**).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../EasyLangApi.csproj" />
  </ItemGroup>

</Project>
