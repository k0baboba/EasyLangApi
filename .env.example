# Скопируйте в .env и заполните. Файл .env не коммитится.

# Секрет подписи JWT, не короче 32 символов. Пусто — случайный ключ при каждом запуске.
JWT_SIGNING_KEY=

# Языковая модель. Пусто — работает словарь dictionaryapi.dev.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1/
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Ollama из профиля llm:
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=llama3.2
# LLM_TIMEOUT_SECONDS=600   # модель на CPU отвечает медленно
